# 到 Neon 專案的 Dashboard -> Connection string 複製（記得選 "Pooled connection"）
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# 隨便打一長串亂碼即可，用來簽發登入 token，不要外流
JWT_SECRET=請改成一串長亂碼

# 你自己登入這個系統要用的密碼（管理密碼），之後在畫面上的登入框輸入這個
ADMIN_PASSWORD=請改成你自己的密碼

# 允許呼叫這支 API 的網站網址（你的 GitHub Pages 網址），本機測試可先用 *
ALLOWED_ORIGIN=https://workersss456-rgb.github.io
